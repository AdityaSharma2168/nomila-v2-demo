node_modules/
cloud-sql-proxy.exe
server_dist/
.env
.env.local
.env*.local
*.log
.expo/
dist/
build/
.DS_Store

# Cloud SQL Auth Proxy binary (downloaded locally for dev:proxy)
cloud-sql-proxy

# App Store Connect API key (never commit)
credentials/
*.p8

# Local webhook secrets (never commit)
.stripe-webhook-secret.local

# Temporary backing store for precomputed brand-fit narratives (server/voice/brandFitStore.ts).
# Scaffolding until the real brand_fit_narratives table lands; machine-local, never committed.
.brand-fit-narratives.json
.brand-fit-narratives.json.*.tmp
.claude/
.env.bak*
AUDIT-*.md

# Retired harvested eval fixture (real inbox content). The harvest script is gone and
# real Gmail content is never kept for eval (Google API Limited Use); delete any local
# copy. Ignored only so a stale copy can never be committed.
server/skills/__fixtures__/classifier-eval.harvested.jsonl

# Local developer reports of an athlete's own data (e.g. the requalify dry-run writes
# reports/opps-requalify by default). Never committed.
reports/

# Local classifier-eval cache — regenerated on demand, never shared
server/scripts/.cache/

# Studio spike cost log (server/studio/costLog.ts) — local instrumentation, never committed
studio-cost-log*.jsonl

# Timestamped .env backups (setup-dev-env.sh, manual repairs) — full of secrets.
# `.env` alone does not cover these, and an untracked file of keys is one `git add -A`
# away from being committed.
.env.backup-*

# PR-0 capability probe: the generated images are large and reproducible from the
# scripts; the run log is the record and is committed.
probe-out/*
!probe-out/runs.jsonl

# creative-QA calibration corpus — photographs of a real person. Manifest only.
qa-fixtures/*
!qa-fixtures/manifest.json

# Local social-substrate fixture exports (real athlete data) are never committed; tests use the synthetic generator.
server/services/intelligence/social/__fixtures__/

# Research provider benchmark runs (Step 4 calibration): real provider output about real people,
# regenerated by server/scripts/calibration/providerBenchmark.ts. The cohort and gold files are committed; runs never are.
server/scripts/calibration/runs/*
# Exception: the blind-evaluator validation record IS committed. Unlike the provider benchmark runs above it is not
# regenerable — the LLM research behind each run cannot be reproduced exactly later — and the frozen 44-signal outputs
# are the golden gate the deterministic scorer must reproduce after any refactor. See runs/blind-eval-v2/PROVENANCE.md.
!server/scripts/calibration/runs/blind-eval/
!server/scripts/calibration/runs/blind-eval-v2/
rate-review/

# Agent eval runs (scripts/run-agent-eval.ts): real provider output about real people, like the benchmark runs
# above. Regenerable; never committed by default — share a report deliberately if needed.
evals/agent/runs/
# The Mila v2 live run's report (evals/agent/mila-v2/run.ts --out, default ./mila-v2-out): real model replies.
mila-v2-out/

# Local, uncommitted agent smoke scripts
*.local.tmp
*.local.ts

# Local folders that live next to the code but never belong in the repo:
# nested worktree checkouts, a third-party clone and personal research notes.
# (reports/ is already ignored above.)
/nomila-v2-*/
/lightcraft/
/research_notes/

# Local Mastra Studio (tools/mila-studio, its own package): its install and the bundle mastra dev builds
tools/mila-studio/node_modules/
tools/mila-studio/.mastra/
tools/mila-studio/src/public/

# Voice samples for approval (scripts/voice-samples.ts): local only, never committed.
media/voice-samples/
