{
  "name": "nomila-v2",
  "main": "client/index.js",
  "version": "1.0.0",
  "scripts": {
    "expo:dev": "cross-env EXPO_PUBLIC_MILA_THREAD_V2=true EXPO_PUBLIC_MILA_CARDS_V2=true EXPO_PUBLIC_API_URL=https://nomila-v2-iau7alh5qq-uc.a.run.app EXPO_PUBLIC_MICROSOFT_CLIENT_ID=d614f3fe-6f13-4c94-a5b9-2f715a66e015 npx expo start",
    "expo:dev:local": "npm run expo:dev",
    "expo:start:static:build": "npx expo start --no-dev --minify --localhost",
    "eas:build:preview": "eas build --profile preview --platform all",
    "eas:update:preview": "eas update --branch preview --environment preview",
    "server:dev": "cross-env NODE_ENV=development tsx --require dotenv/config server/index.ts",
    "eval:mila": "tsx --require dotenv/config scripts/run-mila-eval.ts",
    "eval:agent": "cross-env LOG_LEVEL=warn tsx --require dotenv/config scripts/run-agent-eval.ts",
    "dev:proxy": "./cloud-sql-proxy gamechanger-pocket-agent:us-central1:nomila-v2-db --port=5440",
    "server:build": "esbuild server/index.ts --platform=node --packages=external --bundle --format=cjs --tsconfig=tsconfig.server.json --out-extension:.js=.cjs --outdir=server_dist",
    "server:prod": "NODE_ENV=production node server_dist/index.cjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "test": "cross-env NODE_OPTIONS=\"--experimental-vm-modules --max-old-space-size=4096\" LOG_LEVEL=silent tsx scripts/run-tests.ts",
    "lint": "npx expo lint",
    "lint:fix": "npx expo lint --fix",
    "check:types": "tsc --noEmit",
    "mila:lock": "tsx scripts/mila-lock.ts",
    "mila:golden": "cross-env LOG_LEVEL=silent tsx scripts/mila-golden.ts",
    "catalogue": "cross-env LOG_LEVEL=silent tsx scripts/catalogue/build.ts",
    "evals:live": "cross-env LOG_LEVEL=silent tsx scripts/evals-live.ts",
    "evals:live:mila-v2": "cross-env LOG_LEVEL=silent tsx evals/agent/mila-v2/run.ts --configs v2-sol --runs 1 --budget 5",
    "mila:studio": "npm --prefix tools/mila-studio run studio",
    "jobs:golden": "cross-env LOG_LEVEL=silent tsx scripts/jobs-golden.ts",
    "studio:phrasebook": "cross-env LOG_LEVEL=silent tsx server/studio/phrasebook/generate.ts",
    "check:format": "prettier --check \"**/*.{js,ts,tsx,css,json}\"",
    "format": "prettier --write \"**/*.{js,ts,tsx,css,json}\""
  },
