{
  "name": "nomila-remotion",
  "private": true,
  "description": "Motion renderer: Remotion compositions (brand book reel, title card, countdown) and the Cloud Run render service that runs them.",
  "scripts": {
    "studio": "remotion studio src/index.ts",
