{
  "expo": {
    "name": "Nomila",
    "slug": "nomila",
    "version": "1.3.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "co.nomila.app",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FAF8F5",
    "ios": {
      "supportsTablet": true,
      "backgroundColor": "#FAF8F5",
      "bundleIdentifier": "co.nomila.app",
      "buildNumber": "1",
      "entitlements": {
        "aps-environment": "development",
        "com.apple.security.application-groups": [
          "group.co.nomila.app"
        ]
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSMicrophoneUsageDescription": "Nomila uses your microphone so you can talk to Mila instead of typing, and so people who booked a video call with you can hear you.",
        "NSCameraUsageDescription": "Nomila uses your camera for video calls with people who booked you, to photograph a contract instead of typing it out, or to take a shot to use in a post.",
        "NSPhotoLibraryUsageDescription": "Nomila reads photos you choose so you can attach them to a deal, or make posts and ads from them in Studio — including AI edits you ask for.",
        "UIBackgroundModes": ["audio"],
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "com.googleusercontent.apps.241621020090-ktpco1g6moehmndre8qf78q89b7globj",
              "co.nomila.app"
            ]
          }
        ],
        "LSApplicationQueriesSchemes": [
          "inflcr",
          "teamworks",
          "com.teamworks.inflcr"
        ]
      },
      "bitcode": false,
      "usesAppleSignIn": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FAF8F5",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "co.nomila.app",
      "permissions": [
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.INTERNET",
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.BLUETOOTH_CONNECT"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-mark.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./node_modules/@expo/vector-icons/build/vendor/react-native-vector-icons/Fonts/Feather.ttf",
            "./node_modules/@expo/vector-icons/build/vendor/react-native-vector-icons/Fonts/Ionicons.ttf"
          ]
        }
      ],
      "@livekit/react-native-expo-plugin",
      "@config-plugins/react-native-webrtc"
    ],
    "experiments": {
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "20aa1c28-9d48-4dd4-a903-fcc85b78f62a"
      }
    },
    "owner": "mia-bhuta-enterprise",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/20aa1c28-9d48-4dd4-a903-fcc85b78f62a"
    }
  }
}
